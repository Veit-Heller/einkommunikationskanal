generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Core fields
  firstName    String?
  lastName     String?
  email        String?
  phone        String? // WhatsApp number in E.164 format
  company      String?
  notes        String?

  // Dynamic custom fields from Excel (stored as JSON)
  customFields String? // JSON string

  // Birthday for age-based group filters
  birthday DateTime?

  messages  Message[]
  campaigns CampaignContact[]
  followUps FollowUp[]
  vorgaenge Vorgang[]
  groups    ContactsOnGroup[]
}

// Versicherungsprodukte pro Kontakt
// Vorgänge — Dokumentenanfragen mit Kunden-Portal-Link
model Vorgang {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  title       String
  description String?  // Erklärtext für den Kunden

  // JSON: [{id, label, completed, completedAt}]
  checklist   String   @default("[]")
  // JSON: [{id, name, url, size, uploadedAt}]
  files       String   @default("[]")
  // JSON: [{id, name, url, size, uploadedAt}] — files from broker to client
  brokerFiles String   @default("[]")
  // JSON: [{id, label, completed, completedAt}]
  brokerTodos String   @default("[]")

  // Eindeutiger Token für den öffentlichen Portal-Link
  token       String   @unique @default(cuid())

  // "offen" | "eingereicht" | "abgeschlossen"
  status      String   @default("offen")

  // Automation fields
  templateId      String?    // which template was used
  dueDate         DateTime?  // optional deadline
  portalSentAt    DateTime?  // when portal link was last sent to client
  lastActivityAt  DateTime?  // last time client did something on the portal
  reminderCount   Int        @default(0)
  lastReminderAt  DateTime?
}

model VorgangTemplate {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  category    String   @default("sonstiges") // "schaden" | "neuvertrag" | "service" | "sonstiges"
  description String?
  // JSON: [{label: string}]
  checklist   String   @default("[]")
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
}


model FollowUp {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  completed   Boolean   @default(false)
  completedAt DateTime?
  type        String    @default("todo") // "call" | "email" | "meeting" | "todo"
  notes       String?
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  channel    String // "whatsapp" | "email"
  direction  String // "inbound" | "outbound"
  content    String
  subject    String? // for email
  externalId String? // Meta message ID or Outlook message ID
  status     String? // "sent" | "delivered" | "read" | "failed"
  sentAt     DateTime?
  mediaUrl  String? // Blob URL for PDF attachment
  mediaName String? // original filename
}

model Campaign {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  channel   String // "whatsapp" | "email" | "both"
  template  String // message template with {{variables}}
  subject   String? // email subject
  status    String   @default("draft") // "draft" | "sending" | "sent"

  // Self-relation for follow-up campaigns
  parentId   String?
  parent     Campaign?  @relation("CampaignFollowUps", fields: [parentId], references: [id])
  followUps  Campaign[] @relation("CampaignFollowUps")

  contacts CampaignContact[]
}

model CampaignContact {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     String   @default("pending") // "pending" | "sent" | "failed"
  sentAt     DateTime?
}

model ContactGroup {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  color       String   @default("#F2EAD3")
  emoji       String?
  description String?
  // JSON: [{field:"age"|"company"|"hasPhone"|"hasEmail", operator:"lt"|"gt"|"between"|"eq"|"contains"|"is", value:any, value2?:any}]
  filter      String?
  members     ContactsOnGroup[]
}

model ContactsOnGroup {
  contactId String
  groupId   String
  addedAt   DateTime @default(now())
  addedBy   String   @default("manual") // "manual" | "filter"
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([contactId, groupId])
}

model Integration {
  id           String    @id @default(cuid())
  type         String    @unique // "outlook" | "whatsapp"
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  config       String? // JSON for additional config
  updatedAt    DateTime  @updatedAt
}
